{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finguard:copilot:analysis-output:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "analysisId",
    "reviewTaskSummary",
    "riskRuleExplanation",
    "businessEvidence",
    "policyCitations",
    "recommendation",
    "reasoningSummary",
    "missingInformation",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "analysisId": { "type": "string", "format": "uuid" },
    "reviewTaskSummary": { "type": "string", "minLength": 1 },
    "riskRuleExplanation": { "type": "string", "minLength": 1 },
    "businessEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transactionId",
          "accountId",
          "amount",
          "currency",
          "ruleCode",
          "reasonCode",
          "sourcePaths"
        ],
        "properties": {
          "transactionId": { "type": "integer", "minimum": 1 },
          "accountId": { "type": "integer", "minimum": 1 },
          "amount": { "type": "number", "minimum": 0 },
          "currency": { "type": "string", "minLength": 1 },
          "ruleCode": { "type": "string", "minLength": 1 },
          "reasonCode": { "type": "string", "minLength": 1 },
          "sourcePaths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "transaction.id", "transaction.accountId", "transaction.amount",
                "transaction.currency", "reviewTask.ruleCode", "reviewTask.reasonCode"
              ]
            }
          }
        }
      }
    },
    "policyCitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentId", "version", "sourcePath", "excerpt"],
        "properties": {
          "documentId": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "sourcePath": { "type": "string", "minLength": 1 },
          "excerpt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recommendation": {
      "type": "string",
      "enum": ["CONFIRMED", "IGNORED", "INSUFFICIENT_EVIDENCE"]
    },
    "reasoningSummary": { "type": "string", "minLength": 1 },
    "missingInformation": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
